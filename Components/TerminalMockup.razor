@inject DocumentationDataService DocData
@inject ClipboardService Clipboard

<div class="terminal-showcase">
    <!-- Step Navigation Pills -->
    <div class="step-nav" style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px;">
        @for (int i = 0; i < cliTabs.Length; i++)
        {
            var idx = i;
            var tab = cliTabs[idx];
            var isCurrent = currentTabIndex == idx;
            <button type="button" 
                    class="btn @(isCurrent ? "primary" : "")" 
                    style="display:flex;align-items:center;gap:8px;padding:8px 14px;font-size:0.85rem;border-radius:6px;@(isCurrent ? "box-shadow:0 0 12px rgba(0,229,255,0.25);" : "")"
                    @onclick="@(() => currentTabIndex = idx)">
                <span style="font-weight:700;opacity:@(isCurrent ? "1" : "0.7");">@(idx + 1).</span>
                <span>@(DocData.CurrentLanguage == "es" ? tab.TitleEs : tab.TitleEn)</span>
            </button>
        }
    </div>

    <!-- Terminal Window Frame with Real Screenshot -->
    <div class="terminal-window" style="box-shadow:0 12px 32px rgba(0,0,0,0.5);border:1px solid var(--color-border-weak);border-radius:8px;overflow:hidden;background:#090e15;">
        <div class="titlebar" style="background:#0b111a;padding:12px 18px;border-bottom:1px solid var(--color-border-weak);display:flex;justify-content:space-between;align-items:center;">
            <div style="display:flex;align-items:center;gap:14px;">
                <div class="titlebar-dots" style="display:flex;gap:6px;">
                    <div class="dot red" style="width:11px;height:11px;border-radius:50%;background:#ff5f56;"></div>
                    <div class="dot yellow" style="width:11px;height:11px;border-radius:50%;background:#ffbd2e;"></div>
                    <div class="dot green" style="width:11px;height:11px;border-radius:50%;background:#27c93f;"></div>
                </div>
                <span style="font-family:var(--font-mono);font-size:0.85rem;color:var(--color-text-strong);font-weight:500;display:inline-flex;align-items:center;gap:6px;">
                    <i class="las la-terminal" style="color:var(--color-accent);font-size:1.1rem;"></i> bash — ~/projects/llmtuner · @(DocData.CurrentLanguage == "es" ? "Captura Real de Terminal" : "Real Terminal Execution")
                </span>
            </div>

            <div style="display:flex;gap:10px;align-items:center;">
                <CopyButton Text="@CurrentTab.Command" Label="@(DocData.CurrentLanguage == "es" ? "Copiar Comando" : "Copy Command")" />
                <span class="pill" style="padding:3px 10px;font-size:0.75rem;border-radius:4px;background:rgba(0,229,255,0.12);color:var(--color-accent);border:1px solid rgba(0,229,255,0.3);font-family:var(--font-mono);">
                    @(currentTabIndex + 1) / @cliTabs.Length
                </span>
            </div>
        </div>

        <!-- High-Resolution Real Screenshot View -->
        <div style="position:relative;background:#090e15;text-align:center;">
            <a href="@CurrentTab.ImageUrl" target="_blank" title="@(DocData.CurrentLanguage == "es" ? "Haz clic para ver captura en tamaño completo" : "Click to view full-size capture")">
                <img src="@CurrentTab.ImageUrl" 
                     alt="@(DocData.CurrentLanguage == "es" ? CurrentTab.TitleEs : CurrentTab.TitleEn)" 
                     style="width:100%;height:auto;display:block;max-height:680px;object-fit:contain;cursor:zoom-in;transition:opacity 0.2s ease;" />
            </a>
        </div>

        <!-- Tab Description & Controls Bar -->
        <div style="background:#0b111a;padding:16px 20px;border-top:1px solid var(--color-border-weak);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px;">
            <div style="max-width:750px;">
                <div style="font-weight:600;font-size:0.95rem;color:var(--color-text-strong);margin-bottom:4px;display:flex;align-items:center;gap:8px;">
                    <span style="color:var(--color-accent);">$ @CurrentTab.Command</span>
                </div>
                <p style="margin:0;font-size:0.85rem;color:var(--color-text-weak);line-height:1.45;">
                    @(DocData.CurrentLanguage == "es" ? CurrentTab.DescriptionEs : CurrentTab.DescriptionEn)
                </p>
            </div>

            <!-- Controls -->
            <div style="display:flex;gap:10px;">
                <button type="button" 
                        class="btn" 
                        style="padding:6px 14px;font-size:0.8rem;" 
                        disabled="@(currentTabIndex == 0)"
                        @onclick="PrevTab">
                    ← @(DocData.CurrentLanguage == "es" ? "Anterior" : "Previous")
                </button>
                <button type="button" 
                        class="btn primary" 
                        style="padding:6px 14px;font-size:0.8rem;" 
                        disabled="@(currentTabIndex == cliTabs.Length - 1)"
                        @onclick="NextTab">
                    @(DocData.CurrentLanguage == "es" ? "Siguiente" : "Next") →
                </button>
            </div>
        </div>
    </div>

    <!-- Technical Telemetry Footer -->
    <div style="margin-top:20px;display:grid;grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));gap:12px;font-family:var(--font-mono);font-size:0.8rem;">
        <div style="background:var(--color-surface);border:1px solid var(--color-border-weak);border-radius:6px;padding:12px 14px;">
            <div style="color:var(--color-text-weak);font-size:0.75rem;margin-bottom:4px;">CLI BINARY</div>
            <div style="color:var(--color-accent);font-weight:600;">bin/llm-tuner</div>
            <div style="color:var(--color-text-weak);font-size:0.72rem;margin-top:2px;">Node 22 ESM · 0 dependencies runtime</div>
        </div>

        <div style="background:var(--color-surface);border:1px solid var(--color-border-weak);border-radius:6px;padding:12px 14px;">
            <div style="color:var(--color-text-weak);font-size:0.75rem;margin-bottom:4px;">INTERACTIVE WIZARD</div>
            <div style="color:var(--color-text-strong);font-weight:600;">@("@inquirer/prompts")</div>
            <div style="color:var(--color-text-weak);font-size:0.72rem;margin-top:2px;">Searchable models & arrow navigation</div>
        </div>

        <div style="background:var(--color-surface);border:1px solid var(--color-border-weak);border-radius:6px;padding:12px 14px;">
            <div style="color:var(--color-text-weak);font-size:0.75rem;margin-bottom:4px;">NON-INTERACTIVE AUTOMATION</div>
            <div style="color:#27c93f;font-weight:600;">--yes / --json Flags</div>
            <div style="color:var(--color-text-weak);font-size:0.72rem;margin-top:2px;">CI/CD & headless script execution</div>
        </div>

        <div style="background:var(--color-surface);border:1px solid var(--color-border-weak);border-radius:6px;padding:12px 14px;">
            <div style="color:var(--color-text-weak);font-size:0.75rem;margin-bottom:4px;">PRESET RESOLUTION</div>
            <div style="color:var(--color-accent);font-weight:600;">Instant Cache Hit</div>
            <div style="color:#27c93f;font-size:0.72rem;margin-top:2px;">~15s load bypasses physical measurement</div>
        </div>
    </div>
</div>

@code {
    private int currentTabIndex = 0;

    private TabInfo CurrentTab => cliTabs[currentTabIndex];

    private void NextTab()
    {
        if (currentTabIndex < cliTabs.Length - 1) currentTabIndex++;
    }

    private void PrevTab()
    {
        if (currentTabIndex > 0) currentTabIndex--;
    }

    private record TabInfo(
        string ImageUrl,
        string Command,
        string TitleEs,
        string TitleEn,
        string DescriptionEs,
        string DescriptionEn
    );

    private readonly TabInfo[] cliTabs = new[]
    {
        new TabInfo(
            "screenshots/cli-01-wizard.png",
            "llm-tuner",
            "Asistente Interactivo (Wizard)",
            "Interactive Wizard",
            "Asistente guiado paso a paso con menús interactivos: detecta CPU, RAM y GPUs, lista motores disponibles, busca modelos descargados y calcula el contexto óptimo recomendando el perfil adecuado.",
            "Guided step-by-step terminal wizard: inspects CPU, RAM, and GPUs, filters installed engines, searches downloaded models, and estimates maximum all-GPU context lengths."
        ),
        new TabInfo(
            "screenshots/cli-02-headless.png",
            "llm-tuner --engine lmstudio --model qwen/qwen3-coder-30b --ctx 32768 --profile balanced --yes",
            "Modo Headless (Scripts y CI)",
            "Headless Automation Mode",
            "Ejecución no interactiva idónea para scripts de inicio o pipelines CI/CD. Aplica configuración directamente a LM Studio y carga Qwen3 Coder 30B con cero prompts o preguntas manuales.",
            "Non-interactive CLI execution for startup scripts and automated pipelines. Direct configuration injection into LM Studio with zero manual interaction or prompts."
        ),
        new TabInfo(
            "screenshots/cli-03-presets.png",
            "llm-tuner --presets",
            "Caché de Presets Locales",
            "Presets Cache Listing",
            "Muestra la tabla de configuraciones ganadoras guardadas en ~/.config/llm-tuner/presets/. Cada preset almacena la tasa de tokens/s, tipo de KV cache y particionado exacto por tarjeta de video.",
            "Inspects stored winning configurations in ~/.config/llm-tuner/presets/. Lists speed, context tokens, KV cache format, and exact layer split across video cards."
        ),
        new TabInfo(
            "screenshots/cli-04-settings.png",
            "llm-tuner /settings",
            "Menú de Configuración y Preferencias",
            "Settings & Preferences Menu",
            "Menú interactivo para alternar idioma de la CLI (English / Español) y tema visual (Dark / Light / System). Los cambios se persisten inmediatamente en settings.json.",
            "Interactive preferences menu to configure CLI language (English / Spanish) and terminal color theme (Dark / Light / System). Persisted in settings.json."
        ),
        new TabInfo(
            "screenshots/cli-05-help.png",
            "llm-tuner --help",
            "Catálogo de Banderas y Parámetros",
            "Command Parameters & Help",
            "Catálogo completo de banderas CLI: soporte de perfiles (speed/balanced/quality), candidatos de prueba (--candidates), ejecución seca (--dry-run), salida JSON y forzado de medición (--force).",
            "Comprehensive flag reference: load profile goals (speed/balanced/quality), candidate count (--candidates), dry-run previews (--dry-run), and JSON outputs."
        )
    };
}
