@inject DocumentationDataService DocData
@inject ClipboardService Clipboard

<div class="terminal-window">
    <div class="titlebar">
        <div class="titlebar-dots">
            <div class="dot red"></div>
            <div class="dot yellow"></div>
            <div class="dot green"></div>
        </div>
        <div class="terminal-title">bash — ~/projects/llmtuner</div>
        <div class="terminal-tab-group">
            <button type="button" class="term-tab @(activeTab == "wizard" ? "active" : "")" @onclick="@(() => activeTab = "wizard")">
                1. @(DocData.CurrentLanguage == "es" ? "Asistente Interactivo" : "Interactive Wizard")
            </button>
            <button type="button" class="term-tab @(activeTab == "headless" ? "active" : "")" @onclick="@(() => activeTab = "headless")">
                2. @(DocData.CurrentLanguage == "es" ? "CLI Headless" : "Headless CLI")
            </button>
            <button type="button" class="term-tab @(activeTab == "settings" ? "active" : "")" @onclick="@(() => activeTab = "settings")">
                3. @(DocData.CurrentLanguage == "es" ? "Configuración" : "Settings Menu")
            </button>
            <button type="button" class="term-tab @(activeTab == "presets" ? "active" : "")" @onclick="@(() => activeTab = "presets")">
                4. @(DocData.CurrentLanguage == "es" ? "Presets" : "Presets Cache")
            </button>
        </div>
        <div class="terminal-actions">
            <CopyButton Text="@GetActiveCommand()" Label="@(DocData.CurrentLanguage == "es" ? "Copiar" : "Copy")" />
        </div>
    </div>

    <div class="terminal-body">
        @if (activeTab == "wizard")
        {
            <div class="term-line"><span class="prompt">$</span> <span class="command">llm-tuner</span></div>
            <div class="term-line status-ok">✓ Hardware detected: AMD Ryzen 7 5800X (16 threads) · 32 GB RAM</div>
            <div class="term-line status-ok">✓ GPU 0: NVIDIA GeForce RTX 5070 12GB (PCIe 4.0 x16, 11.8 GB free)</div>
            <div class="term-line status-ok">✓ GPU 1: NVIDIA GeForce RTX 5070 12GB (PCIe 4.0 x8, 11.9 GB free)</div>
            <div class="term-line dim">------------------------------------------------------------</div>
            <div class="term-line prompt">? Which engine do you want to use? › <span class="command">LM Studio (detected: 0.4.25)</span></div>
            <div class="term-line prompt">? Choose model: › <span class="command">qwen/qwen2.5-coder-32b</span> (32.8B params, 64 layers)</div>
            <div class="term-line prompt">? Context length (tokens): › <span class="command">16384</span></div>
            <div class="term-line prompt">? Select load profile: › <span class="command">balanced</span> <span class="status-ok">[Recommended: 100% fits in GPU]</span></div>
            <div class="term-line dim">  ⚡ Estimator calculated split: 32 layers → GPU0, 32 layers → GPU1</div>
            <div class="term-line status-warn">ℹ No preset exists for this context & profile. Measuring 3 candidates...</div>
            <div class="term-line">  [1/3] KV f16  · 64 layers GPU · deep ctx ... <span class="command">21.4 t/s</span> (Peak VRAM: 21.8 GB)</div>
            <div class="term-line">  [2/3] KV q8_0 · 64 layers GPU · deep ctx ... <span class="status-ok">26.8 t/s (WINNER)</span> (Peak VRAM: 19.4 GB)</div>
            <div class="term-line">  [3/3] KV q4_0 · 64 layers GPU · deep ctx ... <span class="command">27.3 t/s</span> (Peak VRAM: 18.1 GB)</div>
            <div class="term-line status-ok">✓ Preset saved to: ~/.config/llm-tuner/presets/lmstudio_qwen-qwen2.5-coder-32b_16384_balanced.json</div>
            <div class="term-line status-ok">✓ Model loaded in LM Studio successfully at 26.8 t/s. Ready for requests!</div>
        }
        else if (activeTab == "headless")
        {
            <div class="term-line"><span class="prompt">$</span> <span class="command">llm-tuner --engine lmstudio --model qwen/qwen2.5-coder-32b --ctx 16384 --profile quality --yes</span>
            </div>
            <div class="term-line dim">[llm-tuner] Running in non-interactive mode (--yes enabled)</div>
            <div class="term-line status-ok">[Hardware] 2x NVIDIA RTX 5070 identified. Dual-card load balancing active.</div>
            <div class="term-line">[GGUF] Inspecting tensors for 'qwen2.5-coder-32b-instruct-q8_0.gguf'...</div>
            <div class="term-line status-ok">✓ Quality profile enforced: Using Q8_0 weights with KV Cache q8_0.</div>
            <div class="term-line status-ok">✓ Layer split plan: GPU0: 32 layers | GPU1: 32 layers | 0 CPU offload.</div>
            <div class="term-line status-ok">✓ Applying hardware configuration and model preset...</div>
            <div class="term-line status-ok">✓ Loaded: LM Studio &#64; 24.9 t/s. Zero manual intervention required.</div>
        }
        else if (activeTab == "settings")
        {
            <div class="term-line"><span class="prompt">$</span> <span class="command">llm-tuner /settings</span></div>
            <div class="term-line">┌────────────────────────────────────────────────────────┐</div>
            <div class="term-line">│  <span class="status-ok">LLM Tuner — User Preferences & Configuration</span>         │</div>
            <div class="term-line">├────────────────────────────────────────────────────────┤</div>
            <div class="term-line">│ ? Select setting to change:                            │</div>
            <div class="term-line">│   ❯ <span class="command">Language: English (en)</span> / Español (es)              │</div>
            <div class="term-line">│     Theme: Dark / Light / System (system)              │</div>
            <div class="term-line">│     Exit settings                                      │</div>
            <div class="term-line">└────────────────────────────────────────────────────────┘</div>
            <div class="term-line status-ok">✓ Settings updated: saved to ~/.config/llm-tuner/settings.json</div>
        }
        else if (activeTab == "presets")
        {
            <div class="term-line"><span class="prompt">$</span> <span class="command">llm-tuner --presets</span></div>
            <div class="term-line status-ok">Stored Presets Directory: ~/.config/llm-tuner/presets/</div>
            <div class="term-line dim">ENGINE     MODEL                     CTX    PROFILE   KV     OFFLOAD  SPEED     CREATED</div>
            <div class="term-line">lmstudio   qwen2.5-coder-32b         16K    balanced  q8_0   ALL GPU  <span class="status-ok">26.8 t/s</span>  2026-10-05 14:20</div>
            <div class="term-line">lmstudio   qwen2.5-coder-32b         16K    quality   q8_0   ALL GPU  <span class="status-ok">24.9 t/s</span>  2026-10-05 15:02</div>
            <div class="term-line">lmstudio   qwen2.5-coder-32b         32K    speed     q4_0   ALL GPU  <span class="status-ok">27.3 t/s</span>  2026-10-05 16:11</div>
            <div class="term-line">ollama     qwen2.5-coder:14b         16K    balanced  q8_0   ALL GPU  <span class="status-ok">48.2 t/s</span>  2026-10-05 11:45</div>
            <div class="term-line status-ok">✓ 4 cached presets ready for instant loading without re-benchmarking.</div>
        }
    </div>
</div>

@code {
    private string activeTab = "wizard";

    private string GetActiveCommand() => activeTab switch
    {
        "wizard" => "llm-tuner",
        "headless" => "llm-tuner --engine lmstudio --model qwen/qwen2.5-coder-32b --ctx 16384 --profile quality --yes",
        "settings" => "llm-tuner /settings",
        "presets" => "llm-tuner --presets",
        _ => "llm-tuner"
    };
}
