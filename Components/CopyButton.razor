@inject ClipboardService Clipboard

<button type="button" class="copy-btn @Class" @onclick="HandleCopy" title="@(copied ? "Copied!" : (string.IsNullOrEmpty(Label) ? "Copy" : Label))">
    @if (copied)
    {
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M2.75 15.0938L9 20.25L21.25 3.75" stroke="#03B000" stroke-width="2" stroke-linecap="square" />
        </svg>
        @if (!string.IsNullOrEmpty(Label))
        {
            <span style="color:#03b000;font-family:var(--font-mono);font-size:0.75rem;">
                @(Label == "Copiar" ? "¡Copiado!" : (Label == "Ejemplo" ? "¡Copiado!" : "Copied!"))
            </span>
        }
    }
    else
    {
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M8.75 8.75V2.75H21.25V15.25H15.25M15.25 8.75H2.75V21.25H15.25V8.75Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
        </svg>
        @if (!string.IsNullOrEmpty(Label))
        {
            <span style="font-family:var(--font-mono);font-size:0.75rem;">@Label</span>
        }
    }
</button>

@code {
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Class { get; set; } = "";

    private bool copied = false;

    private async Task HandleCopy()
    {
        if (string.IsNullOrWhiteSpace(Text)) return;
        var ok = await Clipboard.CopyAsync(Text);
        if (ok)
        {
            copied = true;
            StateHasChanged();
            await Task.Delay(2000);
            copied = false;
            StateHasChanged();
        }
    }
}
