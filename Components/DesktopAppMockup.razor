@inject DocumentationDataService DocData

<div class="desktop-showcase">
    <!-- Step Navigation Pills -->
    <div class="step-nav" style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px;">
        @for (int i = 0; i < steps.Length; i++)
        {
            var idx = i;
            var step = steps[idx];
            var isCurrent = currentStepIndex == idx;
            <button type="button" 
                    class="btn @(isCurrent ? "primary" : "")" 
                    style="display:flex;align-items:center;gap:8px;padding:8px 14px;font-size:0.85rem;border-radius:6px;@(isCurrent ? "box-shadow:0 0 12px rgba(0,229,255,0.25);" : "")"
                    @onclick="@(() => currentStepIndex = idx)">
                <span style="font-weight:700;opacity:@(isCurrent ? "1" : "0.7");">@(idx + 1).</span>
                <span>@(DocData.CurrentLanguage == "es" ? step.TitleEs : step.TitleEn)</span>
            </button>
        }
    </div>

    <!-- Electron Window Mockup Frame with Real Screenshot -->
    <div class="desktop-window" style="box-shadow:0 12px 32px rgba(0,0,0,0.5);border:1px solid var(--color-border-weak);border-radius:8px;overflow:hidden;background:#0d1117;">
        <div class="window-header" style="background:#090e15;padding:12px 18px;border-bottom:1px solid var(--color-border-weak);display:flex;justify-content:space-between;align-items:center;">
            <div style="display:flex;align-items:center;gap:14px;">
                <div class="titlebar-dots" style="display:flex;gap:6px;">
                    <div class="dot red" style="width:11px;height:11px;border-radius:50%;background:#ff5f56;"></div>
                    <div class="dot yellow" style="width:11px;height:11px;border-radius:50%;background:#ffbd2e;"></div>
                    <div class="dot green" style="width:11px;height:11px;border-radius:50%;background:#27c93f;"></div>
                </div>
                <span style="font-family:var(--font-mono);font-size:0.85rem;color:var(--color-text-strong);font-weight:500;display:inline-flex;align-items:center;gap:6px;">
                    <i class="las la-desktop" style="color:var(--color-accent);font-size:1.1rem;"></i> LLM Tuner — Desktop App (Electron) · @(DocData.CurrentLanguage == "es" ? "Captura Real en Vivo" : "Real Live Execution")
                </span>
            </div>
            <div style="display:flex;gap:8px;align-items:center;">
                <span class="pill ok" style="padding:3px 10px;font-size:0.75rem;border-radius:4px;background:rgba(39,201,63,0.12);color:#27c93f;border:1px solid rgba(39,201,63,0.3);font-family:var(--font-mono);">
                    Qwen3 Coder 30B · Dual RTX 5070
                </span>
                <span class="pill" style="padding:3px 10px;font-size:0.75rem;border-radius:4px;background:rgba(0,229,255,0.12);color:var(--color-accent);border:1px solid rgba(0,229,255,0.3);font-family:var(--font-mono);">
                    @(currentStepIndex + 1) / @steps.Length
                </span>
            </div>
        </div>

        <!-- High-Resolution Real Screenshot View -->
        <div style="position:relative;background:#0d1117;text-align:center;">
            <a href="@CurrentStep.ImageUrl" target="_blank" title="@(DocData.CurrentLanguage == "es" ? "Haz clic para ver captura en tamaño completo" : "Click to view full-size capture")">
                <img src="@CurrentStep.ImageUrl" 
                     alt="@(DocData.CurrentLanguage == "es" ? CurrentStep.TitleEs : CurrentStep.TitleEn)" 
                     style="width:100%;height:auto;display:block;max-height:680px;object-fit:contain;cursor:zoom-in;transition:opacity 0.2s ease;" />
            </a>
        </div>

        <!-- Step Description & Telemetry Bar -->
        <div style="background:#090e15;padding:16px 20px;border-top:1px solid var(--color-border-weak);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px;">
            <div style="max-width:750px;">
                <div style="font-weight:600;font-size:0.95rem;color:var(--color-text-strong);margin-bottom:4px;display:flex;align-items:center;gap:8px;">
                    <span style="color:var(--color-accent);">[@(DocData.CurrentLanguage == "es" ? "Paso" : "Step") @(currentStepIndex + 1)]</span>
                    <span>@(DocData.CurrentLanguage == "es" ? CurrentStep.TitleEs : CurrentStep.TitleEn)</span>
                </div>
                <p style="margin:0;font-size:0.85rem;color:var(--color-text-weak);line-height:1.45;">
                    @(DocData.CurrentLanguage == "es" ? CurrentStep.DescriptionEs : CurrentStep.DescriptionEn)
                </p>
            </div>

            <!-- Controls -->
            <div style="display:flex;gap:10px;">
                <button type="button" 
                        class="btn" 
                        style="padding:6px 14px;font-size:0.8rem;" 
                        disabled="@(currentStepIndex == 0)"
                        @onclick="PrevStep">
                    ← @(DocData.CurrentLanguage == "es" ? "Anterior" : "Previous")
                </button>
                <button type="button" 
                        class="btn primary" 
                        style="padding:6px 14px;font-size:0.8rem;" 
                        disabled="@(currentStepIndex == steps.Length - 1)"
                        @onclick="NextStep">
                    @(DocData.CurrentLanguage == "es" ? "Siguiente" : "Next") →
                </button>
            </div>
        </div>
    </div>

    <!-- Hardware & Tuning Benchmark Telemetry Card -->
    <div style="margin-top:20px;display:grid;grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));gap:12px;font-family:var(--font-mono);font-size:0.8rem;">
        <div style="background:var(--color-surface);border:1px solid var(--color-border-weak);border-radius:6px;padding:12px 14px;">
            <div style="color:var(--color-text-weak);font-size:0.75rem;margin-bottom:4px;">MODEL UNDER TEST</div>
            <div style="color:var(--color-accent);font-weight:600;">qwen/qwen3-coder-30b</div>
            <div style="color:var(--color-text-weak);font-size:0.72rem;margin-top:2px;">MoE 8/128 · 48 Layers · Q4_K_M</div>
        </div>

        <div style="background:var(--color-surface);border:1px solid var(--color-border-weak);border-radius:6px;padding:12px 14px;">
            <div style="color:var(--color-text-weak);font-size:0.75rem;margin-bottom:4px;">PHYSICAL HARDWARE</div>
            <div style="color:var(--color-text-strong);font-weight:600;">AMD Ryzen 7 5800X (16T)</div>
            <div style="color:var(--color-text-weak);font-size:0.72rem;margin-top:2px;">76.5 GB RAM DDR4</div>
        </div>

        <div style="background:var(--color-surface);border:1px solid var(--color-border-weak);border-radius:6px;padding:12px 14px;">
            <div style="color:var(--color-text-weak);font-size:0.75rem;margin-bottom:4px;">DUAL GPU BALANCING</div>
            <div style="color:#27c93f;font-weight:600;">2x NVIDIA RTX 5070 12GB</div>
            <div style="color:var(--color-text-weak);font-size:0.72rem;margin-top:2px;">GPU1 (PCIe x16) + GPU0 (PCIe x2)</div>
        </div>

        <div style="background:var(--color-surface);border:1px solid var(--color-border-weak);border-radius:6px;padding:12px 14px;">
            <div style="color:var(--color-text-weak);font-size:0.75rem;margin-bottom:4px;">OBSERVED PERFORMANCE</div>
            <div style="color:var(--color-accent);font-weight:600;">145.8 – 177.1 tokens/s</div>
            <div style="color:#27c93f;font-size:0.72rem;margin-top:2px;">KV f16 · 100% GPU · 0% CPU Offload</div>
        </div>
    </div>
</div>

@code {
    private int currentStepIndex = 0;

    private StepInfo CurrentStep => steps[currentStepIndex];

    private void NextStep()
    {
        if (currentStepIndex < steps.Length - 1) currentStepIndex++;
    }

    private void PrevStep()
    {
        if (currentStepIndex > 0) currentStepIndex--;
    }

    private record StepInfo(
        string ImageUrl,
        string TitleEs,
        string TitleEn,
        string DescriptionEs,
        string DescriptionEn
    );

    private readonly StepInfo[] steps = new[]
    {
        new StepInfo(
            "screenshots/01-engine-selection.png",
            "Detección de Hardware y Selección de Motor",
            "Hardware Detection & Engine Selection",
            "Identificación física en milisegundos de CPU (Ryzen 7 5800X), memoria RAM (76.5 GB) y topología multi-GPU (2x RTX 5070 12GB). Se recomienda automáticamente LM Studio por su capacidad nativa de particionar capas en múltiples GPUs.",
            "Instant hardware inspection identifying CPU (Ryzen 7 5800X), RAM (76.5 GB), and multi-GPU topology (2x RTX 5070 12GB). LM Studio is automatically recommended for native multi-GPU layer distribution."
        ),
        new StepInfo(
            "screenshots/02-model-selection.png",
            "Modelo Qwen3 Coder 30B, Contexto y Perfil de Carga",
            "Qwen3 Coder 30B, Context & Load Profile",
            "Selección de Qwen3 Coder 30B (MoE 8/128, 48 capas, Q4_K_M). Ajuste de contexto a 32K tokens, recomendación del perfil Balanced y detección instantánea del preset guardado en disco con una tasa previa de 177.1 t/s.",
            "Model selection of Qwen3 Coder 30B (MoE 8/128, 48 layers, Q4_K_M). 32K context length, Balanced profile recommendation, and instant cache hit for hardware preset previously verified at 177.1 t/s."
        ),
        new StepInfo(
            "screenshots/03-model-loaded.png",
            "Carga Instantánea desde Preset (145.8 t/s)",
            "Instant Load from Preset (145.8 t/s)",
            "Carga completada en ~15 segundos omitiendo la fase de benchmarks gracias a la huella de hardware. Todas las 48 capas alojadas 100% en VRAM, con KV Cache f16 alcanzando 145.8 tokens/segundo estables.",
            "Load completed in ~15 seconds bypassing redundant benchmarks via hardware fingerprint cache. All 48 layers fit 100% in GPU VRAM with KV cache f16 sustaining 145.8 tokens/s."
        ),
        new StepInfo(
            "screenshots/04-chat-benchmark.png",
            "Inferencia en Vivo y Prueba de Conexión",
            "Live Inference & Connection Benchmark",
            "Probador de conexión en tiempo real comunicándose directamente con el endpoint local cargado. Generación de código Python (Fibonacci con memoización) ejecutada por Qwen3 Coder 30B.",
            "Real-time connection tester dispatching prompts to the loaded local endpoint. Live Python code generation (Fibonacci memoization) directly from Qwen3 Coder 30B."
        ),
        new StepInfo(
            "screenshots/05-settings-drawer.png",
            "Panel de Configuración y Personalización",
            "User Preferences & Settings Drawer",
            "Panel deslizable nativo para cambiar idioma (Español / Inglés) y modo visual (Dark / Light / System). Los ajustes persisten en ~/.config/llm-tuner/settings.json.",
            "Native flyout drawer for language switching (English / Spanish) and visual theme (Dark / Light / System). Stored in ~/.config/llm-tuner/settings.json."
        )
    };
}
