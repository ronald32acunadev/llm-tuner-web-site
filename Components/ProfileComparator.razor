@inject DocumentationDataService DocData

<div class="panel" style="margin-top:24px;">
    <header>
        <div>
            <h3 style="font-size:1.1rem;font-weight:600;margin-bottom:4px;">
                ⚡ @(DocData.CurrentLanguage == "es" ? "Comparativa de Perfiles de Carga" : "Load Profiles Comparison")
            </h3>
            <p style="font-size:0.85rem;color:var(--muted);margin:0;">
                @(DocData.CurrentLanguage == "es"
                    ? "Más tokens por segundo no siempre significa mejores respuestas. Elige el balance exacto entre throughput y fidelidad."
                    : "More tokens per second does not mean better answers. Choose your exact trade-off between throughput and answer quality.")
            </p>
        </div>
    </header>

    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(280px, 1fr));gap:16px;margin-top:16px;">
        @foreach (var prof in DocData.GetProfiles())
        {
            <div class="panel" style="border:1px solid @(prof.IsDefault ? "var(--accent)" : "var(--line)");background:var(--code-bg);border-radius:8px;padding:16px;display:flex;flex-direction:column;gap:12px;position:relative;">
                @if (prof.IsDefault)
                {
                    <div style="position:absolute;top:12px;right:12px;">
                        <span class="pill ok" style="font-size:0.7rem;">Default</span>
                    </div>
                }

                <div>
                    <h4 style="font-size:1.05rem;font-weight:600;color:@(prof.IsDefault ? "var(--accent)" : "var(--ink)");">
                        @prof.Name
                    </h4>
                    <small style="color:var(--muted);font-size:0.8rem;display:block;margin-top:2px;">
                        @prof.Tagline
                    </small>
                </div>

                <p style="font-size:0.85rem;line-height:1.5;margin:0;color:var(--ink);">
                    @prof.Description
                </p>

                <div style="background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:10px;font-size:0.8rem;display:grid;gap:6px;">
                    <div>
                        <span style="color:var(--muted);font-size:0.72rem;text-transform:uppercase;display:block;">KV Cache Types</span>
                        <code style="color:var(--accent);">@prof.KvTypes</code>
                    </div>
                    <div>
                        <span style="color:var(--muted);font-size:0.72rem;text-transform:uppercase;display:block;">Target Variant</span>
                        <span style="font-weight:500;">@prof.TargetVariant</span>
                    </div>
                    <div>
                        <span style="color:var(--muted);font-size:0.72rem;text-transform:uppercase;display:block;">Trade-off</span>
                        <span style="color:var(--warn);">@prof.TradeOff</span>
                    </div>
                </div>

                <div style="margin-top:auto;font-size:0.78rem;color:var(--muted);">
                    <strong>@(DocData.CurrentLanguage == "es" ? "Recomendado:" : "Recommended:")</strong> @prof.RecommendedCondition
                </div>
            </div>
        }
    </div>
</div>
