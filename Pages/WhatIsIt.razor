@page "/what"
@inject DocumentationDataService DocData
@implements IDisposable

<PageTitle>@(DocData.CurrentLanguage == "es" ? "¿Qué es LLM Tuner? — Arquitectura y Capacidades" : "What is LLM Tuner? — Architecture & Capabilities")</PageTitle>

<div class="page-container" style="max-width:1150px;margin:0 auto;padding:40px 24px 80px;">
    <header class="section-header" style="margin-bottom:36px;text-align:center;">
        <h1 style="font-size:2.2rem;font-weight:700;color:var(--color-text-strong);letter-spacing:-0.03em;margin-bottom:12px;">
            @(DocData.CurrentLanguage == "es" ? "¿Qué es LLM Tuner?" : "What is LLM Tuner?")
        </h1>
        <p style="color:var(--color-text-weak);font-size:1.1rem;max-width:760px;margin:0 auto;line-height:1.6;">
            @(DocData.CurrentLanguage == "es"
                ? "Un afinador determinista de rendimiento que elimina cuellos de botella de CPU y encuentra la partición ideal de capas en tu hardware."
                : "A deterministic tuning agent that removes CPU bottlenecks and identifies the exact layer split for your hardware.")
        </p>
    </header>

    <div class="pillars-grid" style="display:grid;grid-template-columns:repeat(auto-fit, minmax(320px, 1fr));gap:20px;margin-bottom:48px;">
        <!-- Pillar 1 -->
        <div class="panel pillar-card" style="padding:24px;background:var(--color-background-weak);border:1px solid var(--color-border-weak);border-radius:8px;display:flex;flex-direction:column;gap:12px;">
            <div style="display:flex;align-items:center;gap:12px;">
                <div style="width:40px;height:40px;border-radius:8px;background:var(--color-accent-dim);display:flex;align-items:center;justify-content:center;color:var(--color-accent);font-size:1.4rem;">
                    <i class="las la-atom"></i>
                </div>
                <h3 style="font-size:1.1rem;font-weight:600;color:var(--color-text-strong);margin:0;">
                    @(DocData.CurrentLanguage == "es" ? "100% Determinista" : "100% Deterministic")
                </h3>
            </div>
            <p style="color:var(--color-text);font-size:0.9rem;line-height:1.5;margin:0;">
                @(DocData.CurrentLanguage == "es"
                    ? "Ninguna IA decide la configuración. Fórmulas exactas sobre metadatos GGUF, consumo de tensores y mediciones físicas reales."
                    : "No LLM decides configuration. Pure GGUF tensor math, VRAM formulas, and real physical tests.")
            </p>
        </div>

        <!-- Pillar 2 -->
        <div class="panel pillar-card" style="padding:24px;background:var(--color-background-weak);border:1px solid var(--color-border-weak);border-radius:8px;display:flex;flex-direction:column;gap:12px;">
            <div style="display:flex;align-items:center;gap:12px;">
                <div style="width:40px;height:40px;border-radius:8px;background:var(--color-accent-dim);display:flex;align-items:center;justify-content:center;color:var(--color-accent);font-size:1.4rem;">
                    <i class="las la-microchip"></i>
                </div>
                <h3 style="font-size:1.1rem;font-weight:600;color:var(--color-text-strong);margin:0;">
                    @(DocData.CurrentLanguage == "es" ? "Topología Multi-GPU Inteligente" : "Multi-GPU Topology")
                </h3>
            </div>
            <p style="color:var(--color-text);font-size:0.9rem;line-height:1.5;margin:0;">
                @(DocData.CurrentLanguage == "es"
                    ? "Prioriza tarjetas con mayor ancho de banda PCIe (x16/x8) y sin monitor conectado, balanceando VRAM restante."
                    : "Prioritizes cards with widest PCIe links and no display attached, balancing leftover headroom.")
            </p>
        </div>

        <!-- Pillar 3 -->
        <div class="panel pillar-card" style="padding:24px;background:var(--color-background-weak);border:1px solid var(--color-border-weak);border-radius:8px;display:flex;flex-direction:column;gap:12px;">
            <div style="display:flex;align-items:center;gap:12px;">
                <div style="width:40px;height:40px;border-radius:8px;background:var(--color-accent-dim);display:flex;align-items:center;justify-content:center;color:var(--color-accent);font-size:1.4rem;">
                    <i class="las la-database"></i>
                </div>
                <h3 style="font-size:1.1rem;font-weight:600;color:var(--color-text-strong);margin:0;">
                    @(DocData.CurrentLanguage == "es" ? "Presets sin Medición Redundante" : "Cached Hardware Presets")
                </h3>
            </div>
            <p style="color:var(--color-text);font-size:0.9rem;line-height:1.5;margin:0;">
                @(DocData.CurrentLanguage == "es"
                    ? "Guarda la configuración ganadora por huella de hardware. Cargas posteriores toman ~20s sin re-medir."
                    : "Stores winners by hardware fingerprint. Future model loads take ~20s directly with zero delay.")
            </p>
        </div>

        <!-- Pillar 4 -->
        <div class="panel pillar-card" style="padding:24px;background:var(--color-background-weak);border:1px solid var(--color-border-weak);border-radius:8px;display:flex;flex-direction:column;gap:12px;">
            <div style="display:flex;align-items:center;gap:12px;">
                <div style="width:40px;height:40px;border-radius:8px;background:var(--color-accent-dim);display:flex;align-items:center;justify-content:center;color:var(--color-accent);font-size:1.4rem;">
                    <i class="las la-server"></i>
                </div>
                <h3 style="font-size:1.1rem;font-weight:600;color:var(--color-text-strong);margin:0;">
                    @(DocData.CurrentLanguage == "es" ? "LM Studio & Ollama" : "LM Studio & Ollama")
                </h3>
            </div>
            <p style="color:var(--color-text);font-size:0.9rem;line-height:1.5;margin:0;">
                @(DocData.CurrentLanguage == "es"
                    ? "Detección automática e instalación oficial (winget, brew o script) si el motor no se encuentra en el sistema."
                    : "Auto-detection plus official installer routines (winget, Homebrew, curl scripts) if missing.")
            </p>
        </div>

        <!-- Pillar 5 -->
        <div class="panel pillar-card" style="padding:24px;background:var(--color-background-weak);border:1px solid var(--color-border-weak);border-radius:8px;display:flex;flex-direction:column;gap:12px;">
            <div style="display:flex;align-items:center;gap:12px;">
                <div style="width:40px;height:40px;border-radius:8px;background:var(--color-accent-dim);display:flex;align-items:center;justify-content:center;color:var(--color-accent);font-size:1.4rem;">
                    <i class="las la-sliders-h"></i>
                </div>
                <h3 style="font-size:1.1rem;font-weight:600;color:var(--color-text-strong);margin:0;">
                    @(DocData.CurrentLanguage == "es" ? "Perfiles de Carga" : "Load Profiles")
                </h3>
            </div>
            <p style="color:var(--color-text);font-size:0.9rem;line-height:1.5;margin:0;">
                @(DocData.CurrentLanguage == "es"
                    ? "Elige entre Speed (máximo t/s), Balanced (equilibrio tps/KV) y Quality (fidelidad f16/q8 sin pérdida)."
                    : "Choose Speed (max TPS), Balanced (speed weighted by KV quality), or Quality (least precision loss).")
            </p>
        </div>

        <!-- Pillar 6 -->
        <div class="panel pillar-card" style="padding:24px;background:var(--color-background-weak);border:1px solid var(--color-border-weak);border-radius:8px;display:flex;flex-direction:column;gap:12px;">
            <div style="display:flex;align-items:center;gap:12px;">
                <div style="width:40px;height:40px;border-radius:8px;background:var(--color-accent-dim);display:flex;align-items:center;justify-content:center;color:var(--color-accent);font-size:1.4rem;">
                    <i class="las la-laptop-code"></i>
                </div>
                <h3 style="font-size:1.1rem;font-weight:600;color:var(--color-text-strong);margin:0;">
                    @(DocData.CurrentLanguage == "es" ? "CLI & Aplicación Desktop" : "Any Interface")
                </h3>
            </div>
            <p style="color:var(--color-text);font-size:0.9rem;line-height:1.5;margin:0;">
                @(DocData.CurrentLanguage == "es"
                    ? "Disponible como asistente de terminal interactivo, comando headless para scripts y app gráfica en Electron."
                    : "Available as an interactive terminal wizard, scriptable headless CLI, and native Electron GUI.")
            </p>
        </div>
    </div>

    <!-- Call to action footer -->
    <div style="display:flex;justify-content:center;gap:16px;flex-wrap:wrap;">
        <a href="showcase" class="cta-button" style="padding:10px 24px;font-size:0.95rem;">
            <i class="las la-laptop-code"></i>
            <span>@(DocData.CurrentLanguage == "es" ? "Explorar Muestrario Visual" : "Explore Showcase")</span>
        </a>
        <a href="commands" class="cta-button" style="padding:10px 24px;font-size:0.95rem;background:var(--color-surface);border-color:var(--color-border);">
            <i class="las la-terminal"></i>
            <span>@(DocData.CurrentLanguage == "es" ? "Ver Comandos CLI" : "View CLI Commands")</span>
        </a>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        DocData.OnLanguageChanged += HandleLangChanged;
    }

    private void HandleLangChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        DocData.OnLanguageChanged -= HandleLangChanged;
    }
}
