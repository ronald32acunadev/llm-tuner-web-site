@page "/"
@inject DocumentationDataService DocData
@implements IDisposable

<PageTitle>LLM Tuner — The open source local LLM tuning agent</PageTitle>

<div class="home-container">
    <!-- SECTION 1: HERO (OpenCode style) -->
    <section id="overview" class="hero">
        <h1>
            @(DocData.CurrentLanguage == "es"
                ? "El afinador de LLMs locales de código abierto"
                : "The open source local LLM tuning agent")
        </h1>

        <p>
            @(DocData.CurrentLanguage == "es"
                ? "Determina la configuración más rápida para ejecutar modelos locales en LM Studio u Ollama sin saturar la CPU."
                : "Finds the fastest configuration to run local models on LM Studio or Ollama with zero GPU memory waste.")
        </p>

        <!-- OPENCODE INSTALLATION TABS -->
        <div class="opencode-install">
            <div class="install-tablist">
                <button type="button" class="install-tab-btn @(installTab == "npm" ? "active" : "")" @onclick="@(() => installTab = "npm")">npm</button>
                <button type="button" class="install-tab-btn @(installTab == "npx" ? "active" : "")" @onclick="@(() => installTab = "npx")">npx</button>
                <button type="button" class="install-tab-btn @(installTab == "git" ? "active" : "")" @onclick="@(() => installTab = "git")">git clone</button>
            </div>

            <div class="install-command-panel">
                <div class="install-script">
                    @if (installTab == "npm")
                    {
                        <span>npm install -g <span class="highlight">llm-tuner</span></span>
                    }
                    else if (installTab == "npx")
                    {
                        <span>npx <span class="highlight">llm-tuner</span></span>
                    }
                    else
                    {
                        <span>git clone <span class="protocol">https://github.com/</span><span class="highlight">ronald32acunadev/llmtuner.git</span></span>
                    }
                </div>
                <CopyButton Text="@GetInstallCommand()" Label="" />
            </div>
        </div>

        <div style="display:flex;justify-content:center;gap:16px;font-family:var(--font-mono);font-size:0.85rem;color:var(--color-text-weak);">
            <span>CLI: <code style="color:var(--color-text-strong);">llm-tuner</code></span>
            <span>·</span>
            <span>Desktop: <code style="color:var(--color-text-strong);">llm-tuner-desktop</code></span>
        </div>
    </section>

    <!-- SECTION 2: TECHNICAL GROWTH STATS (Fig 1, Fig 2, Fig 3 OpenCode style) -->
    <div style="max-width:1150px;margin:0 auto;padding:0 24px;">
        <section class="growth-section">
            <div style="margin-bottom:20px;text-align:center;">
                <span style="font-family:var(--font-mono);font-size:0.8rem;text-transform:uppercase;color:var(--color-text-weak);letter-spacing:0.05em;">
                    BENCHMARK TELEMETRY & SPECS
                </span>
            </div>

            <div class="growth-grid">
                <!-- Fig 1 -->
                <div class="growth-stat-card">
                    <div class="stat-illustration">
                        <svg width="200" height="110" viewBox="0 0 200 110" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M10 95L50 85L90 65L130 35L170 15L190 10" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" />
                            <path d="M10 95H190" stroke="var(--color-border-weak)" stroke-width="1" stroke-dasharray="3 3" />
                            <path d="M10 65H190" stroke="var(--color-border-weak)" stroke-width="1" stroke-dasharray="3 3" />
                            <path d="M10 35H190" stroke="var(--color-border-weak)" stroke-width="1" stroke-dasharray="3 3" />
                            <circle cx="170" cy="15" r="4" fill="var(--color-accent)" />
                            <circle cx="190" cy="10" r="4" fill="var(--color-accent)" />
                        </svg>
                    </div>
                    <div class="stat-caption">
                        <figure>Fig 1.</figure>
                        <strong>2.4×</strong>
                        <span>@(DocData.CurrentLanguage == "es" ? "Aceleración t/s" : "Measured Speedup")</span>
                    </div>
                    <small style="color:var(--color-text-weaker);font-size:0.75rem;margin-top:4px;font-family:var(--font-mono);">
                        11 t/s (CPU saturated) → 26.8 t/s
                    </small>
                </div>

                <!-- Fig 2 -->
                <div class="growth-stat-card">
                    <div class="stat-illustration">
                        <svg width="200" height="110" viewBox="0 0 200 110" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="25" y="25" width="65" height="60" rx="4" stroke="var(--color-text-strong)" stroke-width="1.5" />
                            <rect x="110" y="25" width="65" height="60" rx="4" stroke="var(--color-accent)" stroke-width="1.5" />
                            <text x="57" y="58" fill="var(--color-text-strong)" font-size="11" font-family="var(--font-mono)" text-anchor="middle">GPU 0</text>
                            <text x="142" y="58" fill="var(--color-accent)" font-size="11" font-family="var(--font-mono)" text-anchor="middle">GPU 1</text>
                            <path d="M90 55H110" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" />
                        </svg>
                    </div>
                    <div class="stat-caption">
                        <figure>Fig 2.</figure>
                        <strong>100%</strong>
                        <span>@(DocData.CurrentLanguage == "es" ? "Offload VRAM" : "Full GPU Offload")</span>
                    </div>
                    <small style="color:var(--color-text-weaker);font-size:0.75rem;margin-top:4px;font-family:var(--font-mono);">
                        PCIe 4.0 x16 / x8 lane split
                    </small>
                </div>

                <!-- Fig 3 -->
                <div class="growth-stat-card">
                    <div class="stat-illustration">
                        <svg width="200" height="110" viewBox="0 0 200 110" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="100" cy="55" r="40" stroke="var(--color-border)" stroke-width="2" />
                            <path d="M100 25V55L120 70" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" />
                            <circle cx="100" cy="55" r="3" fill="var(--color-accent)" />
                        </svg>
                    </div>
                    <div class="stat-caption">
                        <figure>Fig 3.</figure>
                        <strong>~20s</strong>
                        <span>@(DocData.CurrentLanguage == "es" ? "Carga Instantánea" : "Instant Model Load")</span>
                    </div>
                    <small style="color:var(--color-text-weaker);font-size:0.75rem;margin-top:4px;font-family:var(--font-mono);">
                        Zero repeated benchmarks via presets
                    </small>
                </div>
            </div>
        </section>

        <!-- SECTION 3: WHAT IS LLM TUNER (Retro-technical feature list with [*] bullets) -->
        <section id="what" class="what-section">
            <div class="what-title">
                <h3>@(DocData.CurrentLanguage == "es" ? "¿Qué es LLM Tuner?" : "What is LLM Tuner?")</h3>
                <p>
                    @(DocData.CurrentLanguage == "es"
                        ? "Un afinador de rendimiento que elimina el cuello de botella de CPU y encuentra la partición ideal de capas en tu hardware."
                        : "A deterministic tuning agent that removes CPU bottlenecks and identifies the exact layer split for your hardware.")
                </p>
            </div>

            <ul class="what-list">
                <li>
                    <span class="bullet">[*]</span>
                    <div>
                        <strong>@(DocData.CurrentLanguage == "es" ? "100% Determinista" : "100% Deterministic")</strong>
                        @(DocData.CurrentLanguage == "es"
                            ? "Ninguna IA decide la configuración. Fórmulas exactas sobre metadatos GGUF y mediciones físicas reales."
                            : "No LLM decides configuration. Pure GGUF tensor math, VRAM formulas, and real physical tests.")
                    </div>
                </li>
                <li>
                    <span class="bullet">[*]</span>
                    <div>
                        <strong>@(DocData.CurrentLanguage == "es" ? "Soporte Multi-GPU Inteligente" : "Multi-GPU Topology")</strong>
                        @(DocData.CurrentLanguage == "es"
                            ? "Prioriza tarjetas con mayor ancho de banda PCIe y sin monitor conectado, balanceando VRAM restante."
                            : "Prioritizes cards with widest PCIe links and no display attached, balancing leftover headroom.")
                    </div>
                </li>
                <li>
                    <span class="bullet">[*]</span>
                    <div>
                        <strong>@(DocData.CurrentLanguage == "es" ? "Presets sin Medición Redundante" : "Cached Hardware Presets")</strong>
                        @(DocData.CurrentLanguage == "es"
                            ? "Guarda la configuración ganadora por huella de hardware. Cargas posteriores toman ~20s sin re-medir."
                            : "Stores winners by hardware fingerprint. Future model loads take ~20s directly with zero delay.")
                    </div>
                </li>
                <li>
                    <span class="bullet">[*]</span>
                    <div>
                        <strong>@(DocData.CurrentLanguage == "es" ? "LM Studio & Ollama" : "LM Studio & Ollama")</strong>
                        @(DocData.CurrentLanguage == "es"
                            ? "Detección automática e instalación oficial (winget, brew o script) si el motor no se encuentra."
                            : "Auto-detection plus official installer routines (winget, Homebrew, curl scripts) if missing.")
                    </div>
                </li>
                <li>
                    <span class="bullet">[*]</span>
                    <div>
                        <strong>@(DocData.CurrentLanguage == "es" ? "Perfiles de Carga" : "Load Profiles")</strong>
                        @(DocData.CurrentLanguage == "es"
                            ? "Elige entre Speed (máximo t/s), Balanced (equilibrio tps/KV) y Quality (fidelidad f16/q8 sin pérdida)."
                            : "Choose Speed (max TPS), Balanced (speed weighted by KV quality), or Quality (least precision loss).")
                    </div>
                </li>
                <li>
                    <span class="bullet">[*]</span>
                    <div>
                        <strong>@(DocData.CurrentLanguage == "es" ? "CLI & Aplicación Desktop" : "Any Interface")</strong>
                        @(DocData.CurrentLanguage == "es"
                            ? "Disponible como asistente de terminal interactivo, comando headless para scripts y app gráfica en Electron."
                            : "Available as an interactive terminal wizard, scriptable headless CLI, and native Electron GUI.")
                    </div>
                </li>
            </ul>
        </section>

        <!-- SECTION 4: VISUAL SHOWCASE (Terminal & Desktop) -->
        <section id="showcase" style="padding:48px 0;border-top:1px solid var(--color-border-weak);">
            <div style="margin-bottom:28px;">
                <h3 style="font-size:1.75rem;font-weight:600;color:var(--color-text-strong);letter-spacing:-0.02em;margin-bottom:8px;">
                    @(DocData.CurrentLanguage == "es" ? "Muestrario Visual de Ejecuciones" : "Visual Execution Showcase")
                </h3>
                <p style="color:var(--color-text-weak);font-size:1rem;">
                    @(DocData.CurrentLanguage == "es"
                        ? "Interactúa con las interfaces reales generadas por el paquete de npm."
                        : "Interact with live mockups faithful to the exact experiences on your local machine.")
                </p>
            </div>

            <!-- Mode Selector Tabs (OpenCode style) -->
            <div style="display:flex;gap:20px;border-bottom:1px solid var(--color-border-weak);margin-bottom:24px;">
                <button type="button" class="install-tab-btn @(showcaseMode == "terminal" ? "active" : "")"
                        style="padding-bottom:10px;font-size:0.95rem;"
                        @onclick="@(() => showcaseMode = "terminal")">
                    💻 @(DocData.CurrentLanguage == "es" ? "Terminal CLI (Wizard / Headless / Presets)" : "Terminal CLI Interface")
                </button>
                <button type="button" class="install-tab-btn @(showcaseMode == "desktop" ? "active" : "")"
                        style="padding-bottom:10px;font-size:0.95rem;"
                        @onclick="@(() => showcaseMode = "desktop")">
                    🖥️ @(DocData.CurrentLanguage == "es" ? "Aplicación Desktop (Electron)" : "Desktop Electron GUI")
                </button>
            </div>

            @if (showcaseMode == "terminal")
            {
                <TerminalMockup />
            }
            else
            {
                <DesktopAppMockup />
            }
        </section>

        <!-- SECTION 5: COMMAND BUILDER & CATALOG -->
        <section id="commands" style="padding:48px 0;border-top:1px solid var(--color-border-weak);">
            <div style="margin-bottom:28px;">
                <h3 style="font-size:1.75rem;font-weight:600;color:var(--color-text-strong);letter-spacing:-0.02em;margin-bottom:8px;">
                    @(DocData.CurrentLanguage == "es" ? "Generador y Catálogo de Comandos" : "Command Builder & Reference")
                </h3>
                <p style="color:var(--color-text-weak);font-size:1rem;">
                    @(DocData.CurrentLanguage == "es"
                        ? "Genera tu comando personalizado o consulta todas las banderas disponibles en el paquete."
                        : "Generate custom flags or inspect the complete parameter catalog.")
                </p>
            </div>

            <CommandBuilder />

            <!-- Command Filter Chips & Table -->
            <div class="panel" style="margin-top:28px;">
                <header style="flex-wrap:wrap;gap:12px;">
                    <div>
                        <h4 style="font-size:1.05rem;font-weight:600;color:var(--color-text-strong);margin-bottom:4px;">
                            📋 @(DocData.CurrentLanguage == "es" ? "Catálogo de Banderas" : "Parameter Catalog")
                        </h4>
                    </div>

                    <div style="display:flex;gap:6px;flex-wrap:wrap;">
                        @foreach (var cat in commandCategories)
                        {
                            <button type="button" class="chip @(selectedCategory == cat ? "active" : "")"
                                    style="padding:4px 10px;font-size:0.75rem;border-radius:4px;border:1px solid var(--color-border-weak);background:@(selectedCategory == cat ? "var(--color-text-strong)" : "transparent");color:@(selectedCategory == cat ? "var(--color-text-inverted)" : "var(--color-text)");cursor:pointer;"
                                    @onclick="@(() => selectedCategory = cat)">
                                @cat
                            </button>
                        }
                    </div>
                </header>

                <div style="overflow-x:auto;margin-top:16px;">
                    <table style="width:100%;border-collapse:collapse;font-size:0.85rem;font-family:var(--font-mono);">
                        <thead>
                            <tr style="border-bottom:1px solid var(--color-border-weak);background:var(--color-background);text-align:left;">
                                <th style="padding:10px 12px;">Flag</th>
                                <th style="padding:10px 12px;">Category</th>
                                <th style="padding:10px 12px;">Default</th>
                                <th style="padding:10px 12px;font-family:var(--font-sans);">Description</th>
                                <th style="padding:10px 12px;">Quick Copy</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cmd in FilteredCommands)
                            {
                                <tr style="border-bottom:1px solid var(--color-border-weak);">
                                    <td style="padding:10px 12px;color:var(--color-accent);font-weight:600;">
                                        @cmd.Flag
                                    </td>
                                    <td style="padding:10px 12px;">
                                        <span class="pill">@cmd.Category</span>
                                    </td>
                                    <td style="padding:10px 12px;color:var(--color-text-weak);">
                                        @cmd.DefaultValue
                                    </td>
                                    <td style="padding:10px 12px;font-family:var(--font-sans);line-height:1.4;color:var(--color-text);">
                                        @cmd.Description
                                    </td>
                                    <td style="padding:10px 12px;">
                                        <CopyButton Text="@cmd.Example" Label="@(DocData.CurrentLanguage == "es" ? "Ejemplo" : "Example")" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- SECTION 6: LOAD PROFILES -->
        <section id="profiles" style="padding:48px 0;border-top:1px solid var(--color-border-weak);">
            <ProfileComparator />
        </section>

        <!-- SECTION 7: ARCHITECTURE & PATHS -->
        <section id="architecture" style="padding:48px 0 64px;border-top:1px solid var(--color-border-weak);">
            <div class="panel">
                <header>
                    <div>
                        <h4 style="font-size:1.15rem;font-weight:600;color:var(--color-text-strong);margin-bottom:4px;">
                            📁 @(DocData.CurrentLanguage == "es" ? "Rutas de Almacenamiento de Presets" : "Preset Storage Locations")
                        </h4>
                        <p style="color:var(--color-text-weak);font-size:0.85rem;margin:0;">
                            @(DocData.CurrentLanguage == "es"
                                ? "Los presets generados son persistidos en directorios estándar según el sistema operativo."
                                : "Presets are saved to standard OS configuration directories.")
                        </p>
                    </div>
                </header>

                <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(280px, 1fr));gap:16px;margin-top:16px;font-family:var(--font-mono);font-size:0.82rem;">
                    <div style="background:var(--color-background);border:1px solid var(--color-border-weak);padding:12px;border-radius:4px;">
                        <span style="color:var(--color-text-strong);display:block;margin-bottom:4px;">🐧 Linux</span>
                        <code style="color:var(--color-accent);">~/.config/llm-tuner/presets/</code>
                    </div>
                    <div style="background:var(--color-background);border:1px solid var(--color-border-weak);padding:12px;border-radius:4px;">
                        <span style="color:var(--color-text-strong);display:block;margin-bottom:4px;">🍎 macOS</span>
                        <code style="color:var(--color-accent);">~/Library/Application Support/llm-tuner/presets/</code>
                    </div>
                    <div style="background:var(--color-background);border:1px solid var(--color-border-weak);padding:12px;border-radius:4px;">
                        <span style="color:var(--color-text-strong);display:block;margin-bottom:4px;">🪟 Windows</span>
                        <code style="color:var(--color-accent);">%APPDATA%\llm-tuner\presets\</code>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

@code {
    private string installTab = "npm";
    private string showcaseMode = "terminal";
    private string selectedCategory = "All";
    private readonly List<string> commandCategories = new() { "All", "Engine", "Model", "Configuration", "Optimization", "Execution", "Automation", "Presets", "Output", "Settings", "General" };

    private string GetInstallCommand() => installTab switch
    {
        "npm" => "npm install -g llm-tuner",
        "npx" => "npx llm-tuner",
        "git" => "git clone https://github.com/ronald32acunadev/llmtuner.git && cd llmtuner && npm install",
        _ => "npm install -g llm-tuner"
    };

    private IEnumerable<CliCommand> FilteredCommands =>
        selectedCategory == "All"
            ? DocData.GetCommands()
            : DocData.GetCommands().Where(c => c.Category.Equals(selectedCategory, StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized()
    {
        DocData.OnLanguageChanged += HandleLangChanged;
    }

    private void HandleLangChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        DocData.OnLanguageChanged -= HandleLangChanged;
    }
}
