@page "/"
@page "/overview"
@inject DocumentationDataService DocData
@implements IDisposable

<PageTitle>LLM Tuner — The open source local LLM tuning agent</PageTitle>

<div class="home-container">
    <!-- SECTION 1: HERO (OpenCode style) -->
    <section id="overview" class="hero">
        <h1>
            @(DocData.CurrentLanguage == "es"
                ? "El afinador de LLMs locales de código abierto"
                : "The open source local LLM tuning agent")
        </h1>

        <p>
            @(DocData.CurrentLanguage == "es"
                ? "Determina la configuración más rápida para ejecutar modelos locales en LM Studio u Ollama sin saturar la CPU."
                : "Finds the fastest configuration to run local models on LM Studio or Ollama with zero GPU memory waste.")
        </p>

        <!-- OPENCODE INSTALLATION TABS -->
        <div class="opencode-install">
            <div class="install-tablist">
                <button type="button" class="install-tab-btn @(installTab == "npm" ? "active" : "")" @onclick="@(() => installTab = "npm")">npm</button>
                <button type="button" class="install-tab-btn @(installTab == "npx" ? "active" : "")" @onclick="@(() => installTab = "npx")">npx</button>
                <button type="button" class="install-tab-btn @(installTab == "git" ? "active" : "")" @onclick="@(() => installTab = "git")">git clone</button>
            </div>

            <div class="install-command-panel">
                <div class="install-script">
                    @if (installTab == "npm")
                    {
                        <span>npm install -g <span class="highlight">llm-tuner</span></span>
                    }
                    else if (installTab == "npx")
                    {
                        <span>npx <span class="highlight">llm-tuner</span></span>
                    }
                    else
                    {
                        <span>git clone <span class="protocol">https://github.com/</span><span class="highlight">ronald32acunadev/llmtuner.git</span></span>
                    }
                </div>
                <CopyButton Text="@GetInstallCommand()" Label="" />
            </div>
        </div>

        <div style="display:flex;justify-content:center;gap:16px;font-family:var(--font-mono);font-size:0.85rem;color:var(--color-text-weak);">
            <span>CLI: <code style="color:var(--color-text-strong);">llm-tuner</code></span>
            <span>·</span>
            <span>Desktop: <code style="color:var(--color-text-strong);">llm-tuner-desktop</code></span>
        </div>
    </section>

    <!-- SECTION 2: TECHNICAL GROWTH STATS (Fig 1, Fig 2, Fig 3 OpenCode style) -->
    <div style="max-width:1150px;margin:0 auto;padding:0 24px;">
        <section class="growth-section">
            <div style="margin-bottom:20px;text-align:center;">
                <span style="font-family:var(--font-mono);font-size:0.8rem;text-transform:uppercase;color:var(--color-text-weak);letter-spacing:0.05em;">
                    BENCHMARK TELEMETRY & SPECS
                </span>
            </div>

            <div class="growth-grid">
                <!-- Fig 1 -->
                <div class="growth-stat-card">
                    <div class="stat-illustration">
                        <svg width="200" height="110" viewBox="0 0 200 110" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M10 95L50 85L90 65L130 35L170 15L190 10" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" />
                            <path d="M10 95H190" stroke="var(--color-border-weak)" stroke-width="1" stroke-dasharray="3 3" />
                            <path d="M10 65H190" stroke="var(--color-border-weak)" stroke-width="1" stroke-dasharray="3 3" />
                            <path d="M10 35H190" stroke="var(--color-border-weak)" stroke-width="1" stroke-dasharray="3 3" />
                            <circle cx="170" cy="15" r="4" fill="var(--color-accent)" />
                            <circle cx="190" cy="10" r="4" fill="var(--color-accent)" />
                        </svg>
                    </div>
                    <div class="stat-caption">
                        <figure>Fig 1.</figure>
                        <strong>2.4×</strong>
                        <span>@(DocData.CurrentLanguage == "es" ? "Aceleración t/s" : "Measured Speedup")</span>
                    </div>
                    <small style="color:var(--color-text-weaker);font-size:0.75rem;margin-top:4px;font-family:var(--font-mono);">
                        11 t/s (CPU saturated) → 26.8 t/s
                    </small>
                </div>

                <!-- Fig 2 -->
                <div class="growth-stat-card">
                    <div class="stat-illustration">
                        <svg width="200" height="110" viewBox="0 0 200 110" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="25" y="25" width="65" height="60" rx="4" stroke="var(--color-text-strong)" stroke-width="1.5" />
                            <rect x="110" y="25" width="65" height="60" rx="4" stroke="var(--color-accent)" stroke-width="1.5" />
                            <text x="57" y="58" fill="var(--color-text-strong)" font-size="11" font-family="var(--font-mono)" text-anchor="middle">GPU 0</text>
                            <text x="142" y="58" fill="var(--color-accent)" font-size="11" font-family="var(--font-mono)" text-anchor="middle">GPU 1</text>
                            <path d="M90 55H110" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" />
                        </svg>
                    </div>
                    <div class="stat-caption">
                        <figure>Fig 2.</figure>
                        <strong>100%</strong>
                        <span>@(DocData.CurrentLanguage == "es" ? "Offload VRAM" : "Full GPU Offload")</span>
                    </div>
                    <small style="color:var(--color-text-weaker);font-size:0.75rem;margin-top:4px;font-family:var(--font-mono);">
                        PCIe 4.0 x16 / x8 lane split
                    </small>
                </div>

                <!-- Fig 3 -->
                <div class="growth-stat-card">
                    <div class="stat-illustration">
                        <svg width="200" height="110" viewBox="0 0 200 110" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="100" cy="55" r="40" stroke="var(--color-border)" stroke-width="2" />
                            <path d="M100 25V55L120 70" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" />
                            <circle cx="100" cy="55" r="3" fill="var(--color-accent)" />
                        </svg>
                    </div>
                    <div class="stat-caption">
                        <figure>Fig 3.</figure>
                        <strong>~20s</strong>
                        <span>@(DocData.CurrentLanguage == "es" ? "Carga Instantánea" : "Instant Model Load")</span>
                    </div>
                    <small style="color:var(--color-text-weaker);font-size:0.75rem;margin-top:4px;font-family:var(--font-mono);">
                        Zero repeated benchmarks via presets
                    </small>
                </div>
            </div>
        </section>

        <!-- SECTION 3: EXPLORATION CARDS -->
        <section class="quick-exploration">
            <div style="margin-bottom:24px;text-align:center;">
                <span style="font-family:var(--font-mono);font-size:0.8rem;text-transform:uppercase;color:var(--color-text-weak);letter-spacing:0.05em;">
                    @(DocData.CurrentLanguage == "es" ? "VISTAS Y MÓDULOS DE DOCUMENTACIÓN" : "DOCUMENTATION MODULES & VIEWS")
                </span>
            </div>

            <div class="exploration-grid">
                <a href="what" class="exploration-card">
                    <i class="las la-question-circle"></i>
                    <h3>@(DocData.CurrentLanguage == "es" ? "¿Qué es?" : "What is it?")</h3>
                    <p>@(DocData.CurrentLanguage == "es" ? "Pilares técnicos y fórmulas deterministas" : "Technical pillars & deterministic formulas")</p>
                </a>

                <a href="showcase" class="exploration-card">
                    <i class="las la-laptop-code"></i>
                    <h3>@(DocData.CurrentLanguage == "es" ? "Muestrario Visual" : "Showcase")</h3>
                    <p>@(DocData.CurrentLanguage == "es" ? "Capturas reales CLI y app Desktop en vivo" : "Live terminal & Desktop GUI captures")</p>
                </a>

                <a href="commands" class="exploration-card">
                    <i class="las la-terminal"></i>
                    <h3>@(DocData.CurrentLanguage == "es" ? "Comandos" : "Commands")</h3>
                    <p>@(DocData.CurrentLanguage == "es" ? "Generador interactivo y catálogo de flags" : "Interactive builder & parameter catalog")</p>
                </a>

                <a href="profiles" class="exploration-card">
                    <i class="las la-sliders-h"></i>
                    <h3>@(DocData.CurrentLanguage == "es" ? "Perfiles" : "Profiles")</h3>
                    <p>@(DocData.CurrentLanguage == "es" ? "Speed vs Balanced vs Quality trade-offs" : "Speed vs Balanced vs Quality trade-offs")</p>
                </a>

                <a href="architecture" class="exploration-card">
                    <i class="las la-sitemap"></i>
                    <h3>@(DocData.CurrentLanguage == "es" ? "Arquitectura" : "Architecture")</h3>
                    <p>@(DocData.CurrentLanguage == "es" ? "Rutas por SO y fingerprinting de hardware" : "OS storage paths & hardware fingerprinting")</p>
                </a>
            </div>
        </section>
    </div>
</div>

@code {
    private string installTab = "npm";

    private string GetInstallCommand() => installTab switch
    {
        "npm" => "npm install -g llm-tuner",
        "npx" => "npx llm-tuner",
        "git" => "git clone https://github.com/ronald32acunadev/llmtuner.git && cd llmtuner && npm install",
        _ => "npm install -g llm-tuner"
    };

    protected override void OnInitialized()
    {
        DocData.OnLanguageChanged += HandleLangChanged;
    }

    private void HandleLangChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        DocData.OnLanguageChanged -= HandleLangChanged;
    }
}
