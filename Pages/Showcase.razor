@page "/showcase"
@inject DocumentationDataService DocData
@implements IDisposable

<PageTitle>@(DocData.CurrentLanguage == "es" ? "Muestrario — LLM Tuner" : "Showcase — LLM Tuner")</PageTitle>

<div class="page-container" style="max-width:1150px;margin:0 auto;padding:40px 24px 80px;">
    <header class="section-header" style="margin-bottom:28px;">
        <h1 style="font-size:2rem;font-weight:700;color:var(--color-text-strong);letter-spacing:-0.02em;margin-bottom:8px;">
            @(DocData.CurrentLanguage == "es" ? "Muestrario" : "Showcase")
        </h1>
        <p style="color:var(--color-text-weak);font-size:1rem;margin:0;">
            @(DocData.CurrentLanguage == "es" 
                ? "Capturas reales de la CLI y la app de escritorio de llm-tuner, pantalla por pantalla." 
                : "Real screenshots of the llm-tuner CLI and desktop app, screen by screen.")
        </p>
    </header>

    <DocsLayout Sections="@DocData.GetShowcaseSections()" Groups="@groups" Route="showcase" />
</div>

@code {
    private List<DocGroup> groups => new()
    {
        new() { Id = "cli", Label = "CLI" },
        new() { Id = "desktop", Label = DocData.CurrentLanguage == "es" ? "Escritorio" : "Desktop" }
    };

    protected override void OnInitialized()
    {
        DocData.OnLanguageChanged += HandleLangChanged;
    }

    private void HandleLangChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        DocData.OnLanguageChanged -= HandleLangChanged;
    }
}
